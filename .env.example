# Enterprise Knowledge Intelligence Platform — Environment Configuration Example

# --- Application Configuration ---
ENV=development
LOG_LEVEL=INFO

# --- Provider & Model Configuration ---
LLM_PROVIDER=ollama
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_BASE_URL=http://localhost:11434

# Optional Paid Upgrade Provider Keys (Section 16)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- PostgreSQL Configuration (Section 4 / 6.7) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekp_db
POSTGRES_USER=ekp_user
POSTGRES_PASSWORD=ekp_password

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Object Storage Configuration (Cloudflare R2 / MinIO) ---
# For Cloudflare R2 Production Deployment:
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=documents

# Optional / Local MinIO Development Fallbacks:
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=documents


# --- Security, CORS & Auth Configuration (Section 3 / 6.1 / 11) ---
JWT_SECRET=change-this-in-production-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Document Ingestion & File Security (Section 6.5) ---
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/html,text/markdown,text/csv

# --- Rate Limiting Configuration (Section 10) ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_EVAL_PER_HOUR=5

